# Zerodha API Credentials
# API_KEY and API_SECRET: from https://kite.zerodha.com/account/settings/developers
# ACCESS_TOKEN: generated daily via the login flow in the UI (leave empty on first run)
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
ACCESS_TOKEN=

# Trading Configuration
PAPER_TRADING=true
CAPITAL_PER_TRADE=100000
MAX_ACTIVE_TRADES=7
MAX_WATCHED_STOCKS=10
DAILY_CAPITAL=100000
STOP_LOSS_PCT=0.01
TIME_EXIT_MINUTES=60

# Bid-Ask Strategy
BID_ASK_THRESHOLD_RATIO=1.6
ENTRY_WAIT_SECONDS=60
MOMENTUM_WINDOW_SECONDS=60

# Time-of-Day Gate — two sessions only
MORNING_SESSION_START=0945
MORNING_SESSION_END=1045
AFTERNOON_SESSION_START=1315
AFTERNOON_SESSION_END=1530

# Minimum stock price (blocks penny stocks below this)
MIN_STOCK_PRICE=50

# Database (relative to backend/)
DATABASE_PATH=trading.db

# API Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
