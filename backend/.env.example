# ── Zerodha Developer Console credentials ────────────────────────────────────
# Get these from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Optional: pre-set access token so the app auto-initialises on startup
# Leave blank and use the /auth/callback flow instead
KITE_ACCESS_TOKEN=

# ── Strategy defaults (can be overridden per-session from the UI) ─────────────
OBI_ENTRY_THRESHOLD=0.30
OBI_SUSTAIN_TICKS=6
OBSERVATION_SECONDS=60
CAPITAL_PER_TRADE=10000
DAILY_PROFIT_TARGET=1000
PER_TRADE_STOP_LOSS=400
DAILY_STOP_LOSS=1000

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./trading.db
